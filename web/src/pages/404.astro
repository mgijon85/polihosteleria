---
import Base from '../layouts/Base.astro';
import { CTA } from '../data/site';
---
<Base title="Página no encontrada | Polihostelería" description="Esta página no existe." noindex>
  <main>
    <section class="page-hero"><div class="wrap">
      <h1>Esta página no existe</h1>
      <p class="lede">Puede que la dirección haya cambiado. Te dejamos lo más buscado.</p>
      <div class="hero-actions"><a class="btn btn--primary" href="/catalogo/">Ver el catálogo</a><a class="btn btn--quiet" href={CTA.href}>{CTA.label}</a><a class="link" href="/">Ir al inicio</a></div>
    </div></section>
  </main>
</Base>
