  <script is:inline src="/scrollcraft/scrollcraft.js"></script>
  <script is:inline>ScrollCraft.mount(document.body);</script>
  <script is:inline>
  (function () {
    // El albarán que se escribe solo. La hora es el cabezal: cada acto lleva un tramo
    // del reloj, y cada línea del albarán aparece cuando el reloj pasa su minuto.
    var root = document.documentElement;
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var small = matchMedia('(max-width: 860px)');
    var acts = Array.prototype.slice.call(document.querySelectorAll('[data-ph-act]'));
    var alb = document.querySelector('[data-alb]');
    var clock = document.querySelector('[data-clock]');
    var items = alb ? Array.prototype.slice.call(alb.querySelectorAll('li[data-at]')).map(function (li) { return { el: li, at: +li.getAttribute('data-at'), on: false }; }) : [];
    var clamp = function (x, a, b) { return x < a ? a : x > b ? b : x; };
    var smooth = function (x) { x = clamp(x, 0, 1); return x * x * (3 - 2 * x); };
    var map = function (p, a, b, c, d) { return c + (d - c) * clamp((p - a) / (b - a), 0, 1); };
    function minutes(n, p) {
      if (n === 1) return 0;
      if (n === 2) return p < 0.36 ? map(p, 0.04, 0.36, 1, 3) : map(p, 0.36, 0.78, 3, 410);
      if (n === 3) return map(p, 0, 1, 410, 515);
      if (n === 4) return map(p, 0, 1, 515, 650);
      return map(p, 0, 0.5, 650, 665);
    }
    function hhmm(m) {
      m = Math.round(m);
      var t = (23 * 60 + 40 + m) % (24 * 60);
      var h = Math.floor(t / 60), mm = t % 60;
      return (h < 10 ? '0' : '') + h + ':' + (mm < 10 ? '0' : '') + mm;
    }
    function actP(a) {
      var v = parseFloat(a.style.getPropertyValue('--sc-p'));
      if (!isNaN(v)) return v;
      var r = a.getBoundingClientRect();
      return clamp(-r.top / Math.max(r.height - innerHeight, 1), 0, 1);
    }
    var last = '';
    function frame() {
      var cur = 1, p = 0, ps = [];
      for (var i = 0; i < acts.length; i++) {
        var v = actP(acts[i]); ps.push(v);
        var top = acts[i].getBoundingClientRect().top;
        if (top <= 1) { cur = i + 1; p = v; }
      }
      var m = minutes(cur, p);
      // el divisor: 50/50, la mañana gana algo en la ruta, y en el cierre la noche se va
      var split = 0.5, dock = 0;
      if (cur === 4) split = 0.5 - 0.12 * smooth(p);
      if (cur === 5) { split = 0.38 * (1 - smooth(map(p, 0.04, 0.46, 0, 1))); dock = smooth(map(p, 0.08, 0.46, 0, 1)); }
      if (reduce) { split = cur === 5 && p > 0.25 ? 0 : 0.5; dock = cur === 5 && p > 0.25 ? 1 : 0; }
      root.style.setProperty('--split', split.toFixed(4));
      root.style.setProperty('--div-o', (cur === 5 ? (1 - map(p, 0.2, 0.42, 0, 1)) * clamp(split / 0.16, 0, 1) : 1).toFixed(3));
      // el albarán viaja con el divisor y, al amanecer, se queda sobre la barra
      if (alb && !small.matches) {
        var vw = innerWidth, vh = innerHeight;
        var x = split * vw * (1 - dock) + (vw * 0.47) * dock;
        var y = vh * 0.6 * (1 - dock) + vh * 0.8 * dock;
        root.style.setProperty('--as', (1 - 0.14 * dock).toFixed(3));
        root.style.setProperty('--ax', x.toFixed(1) + 'px');
        root.style.setProperty('--ay', y.toFixed(1) + 'px');
      }
      var t = hhmm(m);
      if (t !== last && clock) { clock.textContent = t; last = t; }
      var any = false;
      for (var k = 0; k < items.length; k++) {
        var on = m >= items[k].at - 0.001 && !(cur === 1 && m === 0);
        if (items[k].at <= 3 && cur === 1) on = false;
        if (on !== items[k].on) { items[k].on = on; items[k].el.classList.toggle('on', on); }
        if (on) any = true;
      }
      if (alb) { alb.classList.toggle('has-lines', any); alb.classList.toggle('sellado', m >= 665); }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
  </script>
