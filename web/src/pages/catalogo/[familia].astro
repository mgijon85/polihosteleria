---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import Callout from '../../components/Callout.astro';
import { FAMILIAS, CTA, waLink, type Familia } from '../../data/site';
import { foto } from '../../lib/fotos';
import { breadcrumbs, faqPage } from '../../lib/schema';

export function getStaticPaths() {
  return FAMILIAS.map((f) => ({ params: { familia: f.slug }, props: { f } }));
}
const { f } = Astro.props as { f: Familia };
const items = [{ name: 'Catálogo', path: '/catalogo/' }, { name: f.nombre, path: `/catalogo/${f.slug}/` }];
const otras = FAMILIAS.filter((x) => x.slug !== f.slug).slice(0, 3);
const faq = [
  ...f.faq,
  { q: '¿Cómo os hago el pedido?', a: 'Por WhatsApp (también con un audio), por teléfono, por correo o a tu comercial cuando te visita. Te lo llevamos en el siguiente reparto de tu zona.' },
];
const schema = [breadcrumbs(items), faqPage(faq)];
---
<Base title={`${f.titulo} | Polihostelería`} description={f.descripcion} schema={schema}>
  <main>
    <section class="page-hero">
      <div class="wrap split">
        <div>
          <Crumbs items={items} />
          <h1>{f.titulo}</h1>
          <p class="lede">{f.intro}</p>
          <div class="hero-actions">
            <a class="btn btn--primary" href={CTA.href}>{CTA.label}</a>
            <a class="link" href={waLink(`Hola, quería preguntar por ${f.nombre.toLowerCase()}.`)}>Preguntar por WhatsApp</a>
          </div>
        </div>
        <div class="figure" style="aspect-ratio:4/3">
          <Image src={foto(f.foto)} alt={f.alt} widths={[560, 900, 1200]} sizes="(max-width: 860px) 100vw, 46vw" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <section class="section section--surface">
      <div class="wrap split" style="align-items:start">
        <div>
          <h2>Qué te llevamos</h2>
          <ul class="list-check">{f.incluye.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="prose">
          <h3 style="margin-top:0">Formatos</h3>
          <p>{f.formatos}</p>
          <h3>Para quién</h3>
          <p>{f.para}</p>
          <h3>Cómo llega</h3>
          <p>Con nuestras furgonetas, en el día de reparto de tu zona: Huelva capital, la Costa, el Condado o la Sierra. <a class="link" href="/reparto/">Ver zonas</a></p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2>Preguntas frecuentes</h2>
        <div class="faq">
          {faq.map((q) => <details><summary>{q.q}</summary><p>{q.a}</p></details>)}
        </div>
      </div>
    </section>

    <section class="section section--surface">
      <div class="wrap">
        <h2>También te llevamos</h2>
        <div class="tiles">
          {otras.map((o) => (
            <a class="tile" href={`/catalogo/${o.slug}/`}>
              <Image src={foto(o.foto)} alt={o.alt} widths={[400, 720]} sizes="(max-width: 640px) 100vw, 300px" />
              <div class="tile__body"><h3>{o.nombre}</h3><p>{o.corto}</p></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <Callout />
  </main>
</Base>
